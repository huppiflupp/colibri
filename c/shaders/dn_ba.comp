#version 450
// DeltaNet b | a projections of a block on the GPU (f32, as the CPU's matmul_vec):
// ba[s][o] = x[s] . W[o], W = dn_b rows (o < vh) then dn_a rows.
// Grid x = token rows, y = outputs / 4: one 64-lane subgroup per output (the old
// single workgroup per row ran decode's 64 outputs through 4 lanes each, ~30 us).
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer XB { vec4 x4[]; };      // [S][H]
layout(std430, binding = 1) readonly buffer WB { vec4 w4[]; };      // [2*vh][H]
layout(std430, binding = 2) writeonly buffer BA { float ba[]; };    // [S][2*vh]
layout(push_constant) uniform P { int S, H, nout; } p;
void main() {
    uint s = gl_WorkGroupID.x, h4 = uint(p.H) / 4u;
    uint o = gl_WorkGroupID.y * gl_NumSubgroups + gl_SubgroupID, lane = gl_SubgroupInvocationID;
    float acc = 0.0;
    if (o < uint(p.nout))
        for (uint i = lane; i < h4; i += gl_SubgroupSize) acc += dot(x4[s * h4 + i], w4[o * h4 + i]);
    acc = subgroupAdd(acc);
    if (lane == 0u && o < uint(p.nout)) ba[s * uint(p.nout) + o] = acc;
}
